{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    ".opencode/plugins/graphify.js"
  ],
  "mcp": {
    "XcodeBuildMCP": {
      "type": "local",
      "command": ["npx", "-y", "xcodebuildmcp@latest", "mcp"],
      "environment": {
        "XCODEBUILDMCP_ENABLED_WORKFLOWS": "simulator,project-discovery",
        "XCODEBUILDMCP_SENTRY_DISABLED": "true"
      }
    }
  }
}
