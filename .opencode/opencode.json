{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    ".opencode/plugins/graphify.js",
    "@dietrichgebert/ponytail",
    "opencode-caveman"
  ],
  "mcp": {
    "XcodeBuildMCP": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "xcodebuildmcp@latest",
        "mcp"
      ],
      "environment": {
        "XCODEBUILDMCP_ENABLED_WORKFLOWS": "simulator,project-discovery",
        "XCODEBUILDMCP_SENTRY_DISABLED": "true"
      }
    },
    "mobile-mcp": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@mobilenext/mobile-mcp@latest"
      ],
      "enabled": true
    }
  },
  "permission": {
    "skill": {
      "android-jetpack-compose-m3": "deny"
    }
  }
}