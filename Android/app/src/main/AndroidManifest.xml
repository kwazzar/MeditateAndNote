<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- USE_EXACT_ALARM is auto-granted (streak reminders are its intended
         use); SCHEDULE_EXACT_ALARM stays as the fallback on older devices
         where exact alarms need the user toggle. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- The AI draft provider is a remote OpenAI-compatible endpoint the user
         configures; the request goes out over the network. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".MnApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Meditate and Note"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.MeditationCompose">
        <!-- No ads, no advertising identifier, no ad personalization. -->
        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="google_analytics_ssaid_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_ad_personalization_signals"
            android:value="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Book files opened from the file manager (transfer over USB,
                 then tap the file). Without this filter the app never
                 launches for a .fb2/.epub/.txt/.md file. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.fb2" />
                <data android:pathPattern=".*\\.epub" />
                <data android:pathPattern=".*\\.txt" />
                <data android:pathPattern=".*\\.md" />
            </intent-filter>
            <!-- The same, for senders that report a book MIME type instead of
                 a path that ends in the extension. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:mimeType="application/x-fictionbook+zip" />
                <data android:mimeType="application/epub+zip" />
            </intent-filter>
        </activity>
        <!-- Kept exported but without a LAUNCHER filter: the device probes start
             it explicitly with `adb shell am start -n com.mn.android/.debug.MetricsActivity`,
             and the app itself now opens on MainActivity. -->
        <activity
            android:name=".debug.MetricsActivity"
            android:exported="true"
            android:label="Metrics" />

        <!-- Streak reminder alarms: fires the notification and chains the next
             horizon; reschedules everything after reboot (alarms do not
             survive it, unlike iOS UNCalendarNotificationTrigger). -->
        <receiver
            android:name=".infrastructure.platform.notifications.ReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
