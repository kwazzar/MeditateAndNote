# The provider key. It stays on the server: the app never carries it.
GROQ_API_KEY=

# The model the proxy pins. The client may name one; the proxy decides.
GROQ_MODEL=llama-3.3-70b-versatile

# How many tokens one answer may take.
GROQ_MAX_TOKENS=700

# Daily answers per client address. 0 turns the cap off.
DAILY_LIMIT=50

# The store the daily counter lives in, so the cap holds between instances.
# Vercel KV and Upstash inject these into the deployment; without them the
# count stays in the instance's memory.
# KV_REST_API_URL=https://your-db.upstash.io
# KV_REST_API_TOKEN=

# Only for local runs against a fake provider.
# GROQ_URL=http://127.0.0.1:8733/openai/v1/chat/completions
