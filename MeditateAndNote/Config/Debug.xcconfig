// RevenueCat API key — Debug (Test Store).
// The real key is NOT committed: put it in Debug.local.xcconfig (gitignored),
// which is optionally included below and overrides the placeholder.
REVENUECAT_API_KEY = test_REPLACE_ME
#include? "Debug.local.xcconfig"

// The hosted AI provider (our proxy). It carries the provider key, so the app
// ships without one. Empty = the user brings their own endpoint.
AI_DRAFT_ENDPOINT = https://meditate-and-note-ai.vercel.app/api/draft
